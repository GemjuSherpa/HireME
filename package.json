{
  "name": "hireme-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "tsx scripts/bootstrap-synthetic-candidates.ts && tsx scripts/bootstrap-diverse-workers.ts && next dev",
    "build": "next build",
    "start": "tsx scripts/bootstrap-synthetic-candidates.ts && tsx scripts/bootstrap-diverse-workers.ts && next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test e2e/auth-flow.spec.ts",
    "test:e2e:cloud": "playwright test e2e/cloud-smoke.spec.ts --project=chromium",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap-synthetic": "tsx scripts/bootstrap-synthetic-candidates.ts",
    "db:bootstrap-diverse": "tsx scripts/bootstrap-diverse-workers.ts",
    "matching:generate": "PYTHONPATH=matching-service matching-service/.venv/bin/python -m app.synthetic --count 5000 --jobs 50 --seed 20260717 --output matching-service/data/synthetic-ranking.jsonl",
    "matching:train": "PYTHONPATH=matching-service matching-service/.venv/bin/python -m app.train --input matching-service/data/synthetic-ranking.jsonl --output matching-service/artifacts/lambdamart.joblib",
    "matching:test": "cd matching-service && PYTHONPATH=. .venv/bin/pytest",
    "matching:format": "matching-service/.venv/bin/ruff format matching-service",
    "matching:lint": "matching-service/.venv/bin/ruff check matching-service"
  },
  "dependencies": {
    "@faker-js/faker": "10.1.0",
    "@prisma/client": "^6.11.1",
    "lucide-react": "^0.468.0",
    "next": "^15.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.53.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.34",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "prettier": "^3.9.5",
    "prisma": "^6.11.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vercel": "56.3.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
